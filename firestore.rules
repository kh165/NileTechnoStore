rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in with Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user has a registered profile document in Firestore
    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Check if user profile is NOT blocked
    function isNotBlocked() {
      return !isSignedIn() || !hasProfile() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;
    }

    // Check if user is owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && isNotBlocked();
    }

    // Check if user is main admin by token claims or role
    function isMainAdminEmail() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'main_admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    // Check if user is admin — verified server-side from Firestore user document or main admin email
    function isAdmin() {
      return isSignedIn() && (
        isMainAdminEmail() ||
        (hasProfile() && isNotBlocked() &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'main_admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          )
        )
      );
    }

    // Verify validity of order payload
    function isValidOrder() {
      let d = request.resource.data;
      return d.userId is string && d.userId == request.auth.uid
          && d.items is list && d.items.size() > 0
          && d.total is number && d.total > 0
          && d.customerName is string && d.customerName.size() > 0
          && d.customerPhone is string && d.customerPhone.size() >= 10;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId 
                    && (!('role' in request.resource.data) || request.resource.data.role == 'customer' || request.resource.data.role == 'user') 
                    && (!('blocked' in request.resource.data) || request.resource.data.blocked == false);
      allow update: if (isOwner(userId) 
                       && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) 
                       && (!('blocked' in request.resource.data) || request.resource.data.blocked == resource.data.blocked)) 
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders collection: User MUST be signed in + MUST have a registered profile + NOT blocked + valid data
    match /orders/{orderId} {
      allow create: if isSignedIn() && hasProfile() && isNotBlocked() && isValidOrder();
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // User carts collection (synced for logged in users)
    match /user_carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // User wishlists collection (synced for logged in users)
    match /user_wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Activity logs collection
    match /activity_logs/{logId} {
      allow create: if isSignedIn() && isNotBlocked();
      allow read, delete: if isAdmin();
    }

    // Config collection (store settings, shipping rates, featured products)
    match /config/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // Reviews collection: Everyone reads approved, signed-in users with profile can submit
    match /reviews/{reviewId} {
      allow get, list: if resource.data.approved == true || isAdmin();
      allow create: if isSignedIn() && hasProfile() && isNotBlocked()
                    && request.resource.data.productId is string 
                    && request.resource.data.rating is int 
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }
  }
}
